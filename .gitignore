# Data: never commit raw or processed datasets (see data/README.md)
data/raw/
data/processed/
*.h5ad
*.rds

# Generated results are committed selectively; large intermediates are not
results/**/*.tmp

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# R
.Rhistory
.RData
.Rproj.user/

# OS
.DS_Store

# Full screen intermediates: 2,757 ligands and their poses are large and
# regenerable from library.csv with prepare_ligands.py.
screening-full-uxs1/ligands/
screening-full-uxs1/outputs/*_out.pdbqt
screening-full-uxs1/outputs/*_energies.txt
screening-full-uxs1/outputs/redock/
screening-full-uxs1/outputs/recentred/
screening-full-uxs1/logs/*.log
!screening-full-uxs1/logs/*.clean.log
